{
  "name": "kku-oas-borrow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "seed:samples": "node scripts/seed.mjs --with-samples",
    "test:unit": "node scripts/security-tests.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node scripts/security-emulator-tests.mjs\"",
    "test:security": "node scripts/security-tests.mjs && firebase emulators:exec --only firestore \"node scripts/security-emulator-tests.mjs\"",
    "deploy": "next build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.52.0",
    "next": "^15.5.4",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "firebase-admin": "^13.5.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
